# -----------------------------------------------------------------------------
# THE ALMIGHTY'S MATRICULATION SCHOOL - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# 1. OPTION A: RESEND HTTP EMAIL API (Recommended for instant < 500ms delivery to Gmail)
# Free 3,000 emails/month at: https://resend.com/
RESEND_API_KEY=re_your_resend_api_key

# 2. OPTION B: GMAIL SMTP CONFIGURATION (Standard Gmail App Password)
# Create a 16-character Gmail App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=godalmightyschool03@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# 3. FAST2SMS (INDIAN SMS GATEWAY CONFIGURATION)
# Get API key at: https://www.fast2sms.com/
FAST2SMS_API_KEY=your-fast2sms-api-key

# 4. TWILIO SMS CONFIGURATION (Alternative Global SMS Gateway)
# Credentials at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
