# -----------------------------------------------------------------------------
# THE ALMIGHTY'S MATRICULATION SCHOOL - ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# 1. GMAIL / SMTP EMAIL CONFIGURATION (For sending emails via godalmightyschool03@gmail.com)
# Create a 16-character Gmail App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=godalmightyschool03@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# 2. FAST2SMS (INDIAN SMS GATEWAY) CONFIGURATION
# Get your API key at: https://www.fast2sms.com/
FAST2SMS_API_KEY=your-fast2sms-api-key

# 3. TWILIO SMS CONFIGURATION (Alternative Global SMS Gateway)
# Get credentials at: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
